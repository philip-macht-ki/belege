# Kopiere diese Datei nach .env und trag die Werte selbst ein.
# Passwörter gehören nie in den Chat, nie in ein Git-Repo, nie in eine Mail.

# Weg A: das App-Passwort je Postfach. Der Name hinter PASSWORT_ ist der
# name aus [[konto]] in konfig/belege.toml, in Großbuchstaben.
PASSWORT_GESCHAEFT=

# Weg B braucht hier nichts: die Zugänge liegen nach `belege anmelden`
# in arbeit/geheim/.

# nur für [urteil] backend = "anthropic" (kostet je Aufruf)
ANTHROPIC_API_KEY=
