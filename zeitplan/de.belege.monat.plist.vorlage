<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>de.belege.monat</string>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Day</key>
    <integer>__TAG__</integer>
    <key>Hour</key>
    <integer>9</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>cd "__REPO__" &amp;&amp; PATH=/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin:/usr/local/bin:$HOME/.local/bin "__UV__" run belege monat --uebergabe --echt</string>
  </array>
  <key>StandardOutPath</key>
  <string>__REPO__/arbeit/logs/launchd-monat.log</string>
  <key>StandardErrorPath</key>
  <string>__REPO__/arbeit/logs/launchd-monat.log</string>
</dict>
</plist>
