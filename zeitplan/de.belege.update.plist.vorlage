<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>de.belege.update</string>
  <key>StartCalendarInterval</key><dict><key>Weekday</key><integer>0</integer><key>Hour</key><integer>6</integer><key>Minute</key><integer>0</integer></dict>
  <!-- Auch beim Anmelden: War der Mac sonntags aus, holt der nächste Start das Update nach (belege prüft selbst, ob es fällig ist). -->
  <key>RunAtLoad</key><true/>
  <key>ProgramArguments</key><array><string>/bin/zsh</string><string>-lc</string><string>cd "__REPO__" &amp;&amp; PATH=/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin:/usr/local/bin:$HOME/.local/bin "__UV__" run belege aktualisieren --automatisch --echt</string></array>
  <key>StandardOutPath</key><string>__REPO__/arbeit/logs/launchd-update.log</string><key>StandardErrorPath</key><string>__REPO__/arbeit/logs/launchd-update.log</string>
</dict></plist>
