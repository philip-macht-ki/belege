<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>de.belege.takt</string>
  <key>StartInterval</key>
  <integer>__SEKUNDEN__</integer>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>cd "__REPO__" &amp;&amp; PATH=/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin:/usr/local/bin:$HOME/.local/bin "__UV__" run belege takt --echt</string>
  </array>
  <key>StandardOutPath</key>
  <string>__REPO__/arbeit/logs/launchd-takt.log</string>
  <key>StandardErrorPath</key>
  <string>__REPO__/arbeit/logs/launchd-takt.log</string>
</dict>
</plist>
